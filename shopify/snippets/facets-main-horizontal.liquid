{%- comment -%}
  -------------------------------------------------------------------------------
  Facets - Main (Horizontal)
  -------------------------------------------------------------------------------
  Accepts
  - section: {Object} the section object (required)
  - product_grid: {Object} the product grid content, usually submitted
    as a capture (required)
  -------------------------------------------------------------------------------
  Usage
  {%- render 'facets-main-horizontal',
    section: section,
    product_grid: product_grid
  -%}
  -------------------------------------------------------------------------------
  Description
  Renders a horizontal facets bar. Filtering/sorting are controlled globally
  via Theme settings > Collections (settings.enable_filtering /
  settings.enable_sorting), not per-section.
{%- endcomment -%}

{%- liquid
  assign product_grid = product_grid | default: 'You need to submit a capture of the content to interface with the facets'

  # Translations
  if template == 'search'
    assign t = 'templates.search.'
  else
    assign t = 'templates.collection.'
  endif

  if collection != blank
    assign results = collection
  elsif search != blank
    assign results = search
  endif

  # Section Padding Classes
  capture container_class
    if section.settings.padding != 'full'
      echo '-ml-row w-[calc(100%+(var(--row-space)*2))]'
    endif
  endcapture
-%}

{%- if settings.enable_filtering or settings.enable_sorting -%}
  {%- # Facets -%}
  <div class="js-facets mb-9 block border-y border-solid border-border-light py-2 lg:mb-14 lg:py-[21px] {{ container_class }}">
    {%- # Filters Form -%}
    {%- liquid
      capture justification_class
        if results.filters.size == 0 or settings.enable_filtering == false
          echo 'justify-center lg:justify-between'
        else
          echo 'justify-between lg:justify-between'
        endif
      endcapture
    -%}

    <form
      method="get"
      class="flex flex-wrap {{ justification_class }} js-facets-form items-start gap-y-3 px-row lg:gap-x-4"
      data-filtering="{{ settings.enable_filtering }}"
      data-sorting="{{ settings.enable_sorting }}"
      id="Facets"
      aria-label="{{ 'general.facets.filter_and_sort' | t | default: 'Filter and sort products' }}"
    >
      {%- # Filters -%}
      {%- if results.terms -%}
        <input
          type="hidden"
          name="q"
          value="{{ results.terms | escape }}"
        >
        <input
          type="hidden"
          name="options[prefix]"
          value="last"
        >
      {%- endif -%}

      {%- if results.current_vendor or results.current_type -%}
        <input
          type="hidden"
          name="q"
          value="{{ results.current_vendor }}{{ results.current_type }}"
        >
      {%- endif -%}

      {%- if settings.enable_filtering -%}
        {%- # Filters -%}
        {%- if results.filters.size > 0 -%}
          {%- liquid
            capture mobile_classes
              if settings.enable_sorting
                echo 'w-1/2'
              else
                echo 'w-full'
              endif
            endcapture
          -%}

          {%- comment -%}
            A native <details>/<summary> disclosure: collapsed to a "Filters"
            trigger on mobile, always expanded inline on desktop (lg:). No JS
            required for the toggle to work.
          {%- endcomment -%}
          <details class="js-facets-filters {{ mobile_classes }} lg:contents">
            <summary
              class="flex cursor-pointer list-none items-center gap-2 py-4 font-semibold select-none text-sm uppercase tracking-standard lg:hidden"
            >
              {%- render 'theme-icons' with 'sliders', width: 18, height: 18, class: 'flex' -%}

              {{- t | append: 'facets.mobile_drawer.trigger' | t -}}
            </summary>

            <div class="flex w-full flex-col gap-4 pb-4 lg:flex-row lg:flex-wrap lg:items-end lg:gap-6 lg:pb-0">
              {%- render 'facets-filter-list', results: results, t: t -%}

              <div class="flex items-center gap-4">
                <button
                  type="submit"
                  class="button button--secondary js-facets-apply"
                >
                  {{- t | append: 'facets.apply' | t -}}
                </button>

                <a href="{{ results.url }}" class="js-facets-clear-all text-sm font-semibold uppercase tracking-standard underline">
                  {{- t | append: 'facets.clear_all' | t -}}
                </a>
              </div>
            </div>
          </details>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.enable_sorting -%}
        {%- liquid
          assign sort_label_id = 'SortBy-' | append: section.id
        -%}
        <div class="js-facets-sort flex items-center gap-2 max-lg:order-2">
          <label class="whitespace-nowrap text-sm font-semibold uppercase tracking-standard" for="{{ sort_label_id }}">
            {{- t | append: 'facets.sort_by_label' | t -}}
          </label>

          <select
            name="sort_by"
            id="{{ sort_label_id }}"
            class="js-facets-sort-select rounded-1 border border-solid border-border-light bg-white px-3 py-2 text-sm"
          >
            {%- for option in results.sort_options -%}
              {%- liquid
                assign show_option = false

                case option.value
                  when 'manual', 'featured', 'relevance'
                    if settings.sort_manual
                      assign show_option = true
                    endif
                  when 'best-selling'
                    if settings.sort_best_selling
                      assign show_option = true
                    endif
                  when 'title-ascending', 'title-descending'
                    if settings.sort_title
                      assign show_option = true
                    endif
                  when 'price-ascending', 'price-descending'
                    if settings.sort_price
                      assign show_option = true
                    endif
                  when 'created-ascending', 'created-descending'
                    if settings.sort_created
                      assign show_option = true
                    endif
                  else
                    assign show_option = true
                endcase
              -%}

              {%- if show_option -%}
                <option value="{{ option.value }}" {% if option.value == results.sort_by %}selected{% endif %}>
                  {{- option.name -}}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      {%- # Results Count -%}

      <div
        class="js-pagination-external-results min-w-fit text-sm font-semibold uppercase tracking-standard max-lg:hidden"
        data-results-text-none="{{ t | append: 'results.none' | t }}"
        data-results-text-one="{{ t | append: 'results.one' | t }}"
        data-results-text-other="{{ t | append: 'results.other' | t }}"
      >
        {%- assign count = results.products_count | default: results.results_count -%}
        {{- t | append: 'results.other' | t: count: count -}}
      </div>
    </form>

    {%- # Active Filters -%}
    {%- if results.filters.size > 0 -%}
      {%- liquid
        assign active_filters = 0

        for filter in results.filters
          if filter.min_value.value != null and filter.max_value.value != null
            assign active_filters = active_filters | plus: 1

            break
          endif

          if filter.active_values.size > 0
            assign active_filters = active_filters | plus: 1

            break
          endif
        endfor
      -%}

      <div class="js-facets-active">
        {%- if active_filters > 0 -%}
          {%- liquid
            # Slider
            # - [Start]
            capture slider_snippet
              render 'section-slider', target: section, name: 'facets-active-facets-horizontal'
            endcapture

            assign slider_snippet = slider_snippet | split: ' ** '

            assign slider_settings = slider_snippet[0]
            assign slider_classes = slider_snippet[1]
            assign slider_styling = slider_snippet[2]
            assign slider_components = slider_snippet[3] | split: '::'

            assign slider_viewport = slider_components[0]
            assign slider_track_class = slider_components[1] | append: ' px-row'
            # - [End]
          -%}

          {{ slider_styling }}

          <ecomplete-slider
            class="{{ slider_classes }} gap-3 border-t border-solid border-border-light pt-2 lg:mt-5 lg:pt-[21px]"
            {{ slider_settings }}
          >
            <div {{ slider_viewport }}>
              <ul class="{{ slider_track_class }}">
                {%- liquid
                  assign bubble_classes = 'inline-flex min-w-max items-center hover:border-grey-10 transition-colors px-[14px] py-[6px] py-1 text-xs font-semibold border select-none rounded-[50px] o-button gap-x-1 hover:bg-grey-100 js-facet-remove'
                  assign slideIndex = 0
                -%}

                {%- for filter in results.filters -%}
                  {%- for value in filter.active_values -%}
                    {%- assign slideIndex = slideIndex | plus: 1 -%}
                    <li data-slide-index="{{ slideIndex }}">
                      <a
                        href="{{ value.url_to_remove }}"
                        class="{{ bubble_classes }}"
                      >
                        {{- value.label | escape | remove: '[Clothing]' | upcase -}}
                        {%- render 'theme-icons' with 'close', width: 14, height: 14, class: 'stroke-current' -%}
                        <span class="sr-only">{{- t | append: 'facets.clear_filter' | t -}}</span>
                      </a>
                    </li>
                  {%- endfor -%}

                  {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                      {%- assign slideIndex = slideIndex | plus: 1 -%}
                      <li data-slide-index="{{ slideIndex }}">
                        <a
                          href="{{ filter.url_to_remove }}"
                          class="{{ bubble_classes }}"
                        >
                          {%- liquid
                            assign min = filter.min_value.value | default: 0 | money | upcase
                            assign max = filter.max_value.value | default: filter.range_max | money | upcase

                            echo min | append: ' - ' | append: max
                          -%}

                          {%- render 'theme-icons' with 'close', width: 14, height: 14, class: 'stroke-current' -%}
                          <span class="sr-only">{{- t | append: 'facets.clear_filter' | t -}}</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </ecomplete-slider>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- # Product Grid -%}
{{ product_grid }}
