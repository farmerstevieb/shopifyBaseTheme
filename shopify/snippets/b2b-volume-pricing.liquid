{% doc %}
  Renders a B2B volume (quantity-break) pricing table and quantity-rule notice
  for a variant, using Shopify's native B2B catalog data. Only outputs when the
  current customer context actually has price breaks or a non-default quantity
  rule, so it is safe to render unconditionally on the product page.

  @param {variant} variant - The variant to render volume pricing for (usually
    product.selected_or_first_available_variant).
  @param {string} [class] - Optional extra CSS classes for the wrapper.

  @example
  {% render 'b2b-volume-pricing', variant: product.selected_or_first_available_variant %}
{% enddoc %}

{%- liquid
  assign vp_variant = variant
  assign vp_rule = vp_variant.quantity_rule
  assign vp_has_breaks = vp_variant.quantity_price_breaks_configured?
  assign vp_has_rule = false
  if vp_rule.min > 1 or vp_rule.max != null or vp_rule.increment > 1
    assign vp_has_rule = true
  endif
-%}

{%- if vp_has_breaks or vp_has_rule -%}
  <div class="b2b-volume-pricing {{ class }}" data-b2b-volume-pricing>
    {%- if vp_has_rule -%}
      <ul class="b2b-volume-pricing__rules">
        {%- if vp_rule.min > 1 -%}
          <li>{{ 'products.product.quantity_rule.minimum_html' | t: quantity: vp_rule.min }}</li>
        {%- endif -%}
        {%- if vp_rule.max != null -%}
          <li>{{ 'products.product.quantity_rule.maximum_html' | t: quantity: vp_rule.max }}</li>
        {%- endif -%}
        {%- if vp_rule.increment > 1 -%}
          <li>{{ 'products.product.quantity_rule.increment_html' | t: quantity: vp_rule.increment }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if vp_has_breaks -%}
      <div class="b2b-volume-pricing__breaks">
        <p class="b2b-volume-pricing__title">
          {{ 'products.product.volume_pricing.title' | t }}
          {%- if customer.b2b? %}
            <span class="b2b-volume-pricing__note">{{ 'products.product.volume_pricing.note' | t }}</span>
          {%- endif -%}
        </p>
        <table class="b2b-volume-pricing__table">
          <thead class="sr-only">
            <tr>
              <th scope="col">{{ 'products.product.quantity.label' | t | default: 'Quantity' }}</th>
              <th scope="col">{{ 'products.product.price.unit_price' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for price_break in vp_variant.quantity_price_breaks -%}
              <tr class="b2b-volume-pricing__row">
                <td class="b2b-volume-pricing__qty">
                  {{ 'products.product.volume_pricing.minimum_html' | t: quantity: price_break.minimum_quantity }}
                </td>
                <td class="b2b-volume-pricing__price">
                  {{ 'products.product.volume_pricing.price_at_each_html' | t: price: price_break.price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .b2b-volume-pricing {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-light, #d9d9d9);
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .b2b-volume-pricing__rules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    color: #707070;
  }

  .b2b-volume-pricing__title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: #212121;
  }

  .b2b-volume-pricing__note {
    font-weight: 400;
    font-size: 0.75rem;
    color: #8a38f5;
  }

  .b2b-volume-pricing__table {
    width: 100%;
    border-collapse: collapse;
  }

  .b2b-volume-pricing__row td {
    padding: 0.25rem 0;
    border-top: 1px solid var(--color-border-light, #d9d9d9);
  }

  .b2b-volume-pricing__qty {
    color: #212121;
  }

  .b2b-volume-pricing__price {
    text-align: right;
    font-weight: 600;
    color: #2b2b2b;
  }
{% endstylesheet %}
